{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm build",
    "watchPatterns": [
      "/app/**"
    ]
  },
  "deploy": {
    "startCommand": "pnpm start",
    "preDeployCommand": [
      "pnpm db:migrate"
    ],
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
