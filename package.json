{
  "name": "crm",
  "version": "0.1.0",
  "private": true,
  "description": "CRM de conversaciones multicanal (WhatsApp, Instagram, Messenger, Telegram, TikTok, correo y chat web)",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "crear-espacio": "tsx --env-file=.env scripts/crear-espacio.ts",
    "cambiar-clave": "tsx --env-file=.env scripts/cambiar-clave.ts",
    "borrar-espacio": "tsx --env-file=.env scripts/borrar-espacio.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@prisma/client": "^5.0.0",
    "@sentry/node": "^11.6.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.18.0",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "imapflow": "^1.7.8",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jszip": "3.10.1",
    "mailparser": "^3.9.28",
    "mammoth": "^1.13.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "^10.0.16",
    "pdf2json": "^4.1.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "prisma": "^5.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^6.4.24",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
