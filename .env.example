# ── Obligatorias ──────────────────────────────────────────────────────────────
# PostgreSQL 14 o superior.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/crm
# Firma las sesiones y, si no hay CRM_CLAVE_CIFRADO, cifra las claves de los canales. 32 caracteres o más.
# Genera uno con: openssl rand -base64 48
AUTH_SECRET=

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# La dirección pública del CRM (sin barra al final). La usan las direcciones de los avisos (webhooks) que se le
# dan a Meta, TikTok y Telegram, y la burbuja del chat web. Si falta, se toma la de cada petición.
API_PUBLIC_URL=https://crm.tuempresa.com
# Solo si el CRM se publica dentro de otro sitio, en una ruta (https://tuempresa.com/crm): el prefijo, y el proxy de
# enfrente lo quita antes de reenviar. API_PUBLIC_URL lleva entonces el prefijo (https://tuempresa.com/crm).
# Vacío: el CRM vive en la raíz de su dominio.
CRM_BASE=
# Cuántos proxies hay delante: 1 con Railway solo; 2 si además el sitio reenvía la ruta del CRM (Vercel → Railway).
TRUST_PROXY=1
# El nombre del producto que se ve en la pestaña, el inicio de sesión y la barra de arriba.
CRM_NOMBRE=CRM
# El logo en la barra lateral: una dirección https o una ruta del mismo sitio. Vacío: el ícono de fábrica.
CRM_LOGO=
# Zona horaria de los horarios de atención y los informes.
TZ=America/Bogota
LOG_LEVEL=info

# ── Archivos (fotos, audios, documentos de las conversaciones) ────────────────
# Cuenta de Cloudinary. Sin ella el CRM funciona, pero no se pueden adjuntar ni recibir archivos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta dentro de la cuenta.
CLOUDINARY_CARPETA=crm

# ── Inteligencia artificial (opcional) ────────────────────────────────────────
# Agentes IA, sugerencias de respuesta, embudo automático y resúmenes. Sin la llave, esas funciones quedan apagadas.
ANTHROPIC_API_KEY=
# El modelo de los agentes IA.
CRM_MODELO_IA=claude-sonnet-5
# Transcripción de notas de voz. Sin la llave, las notas se escuchan pero no se transcriben.
GEMINI_API_KEY=

# ── Seguridad (opcional) ──────────────────────────────────────────────────────
# Llave propia para cifrar las claves de los canales (32 bytes en hex: openssl rand -hex 32). Si falta, se deriva
# de AUTH_SECRET. Si se cambia, los canales conectados hay que volver a conectarlos.
CRM_CLAVE_CIFRADO=
# Firma de las sesiones del chat web. Si falta, se deriva de AUTH_SECRET.
CRM_WEB_SECRET=
# El espacio al que llega el chat web cuando la burbuja no dice de cuál es (data-espacio).
CRM_ESPACIO=principal
